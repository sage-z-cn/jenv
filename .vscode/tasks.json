{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "jenv: build",
            "detail": "Build exe with PyInstaller",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "jenv: list",
            "detail": "List all installed JDKs",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/jenv.py",
                "list"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "jenv: current",
            "detail": "Show current JAVA_HOME",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/jenv.py",
                "current"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "jenv: help",
            "detail": "Show help information",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/jenv.py",
                "help"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "jenv: use",
            "detail": "Switch JDK version (requires admin)",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/jenv.py",
                "use",
                "${input:jdkVersion}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "jdkVersion",
            "type": "promptString",
            "description": "Enter JDK version to switch to (e.g. 17, 1.8, 25)"
        }
    ]
}
